<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NOTA SPESE" android:textStyle="bold" android:textSize="26sp"
            android:layout_marginBottom="12dp"/>

        <EditText android:id="@+id/etNome" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Nome"/>
        <EditText android:id="@+id/etCognome" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Cognome"/>
        <EditText android:id="@+id/etAzienda" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Azienda di riferimento"/>
        <EditText android:id="@+id/etMese" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Mese (AAAA-MM)"/>

        <Button android:id="@+id/btnSalvaProfilo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Salva intestazione"/>
        <Button android:id="@+id/btnFoto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Scatta foto scontrino"
            android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btnManuale" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Aggiungi spesa manualmente"/>
        <Button android:id="@+id/btnEliminaPeriodo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Cancella spese dalla data / alla data"/>

        <TextView android:id="@+id/tvTotali" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold"
            android:textSize="18sp" android:paddingTop="12dp" android:paddingBottom="8dp"/>

        <LinearLayout android:id="@+id/containerSpese" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>

        <Button android:id="@+id/btnPdf" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Genera PDF nota spese"
            android:layout_marginTop="16dp"/>
        <Button android:id="@+id/btnStampa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Stampa nota spese del mese"/>
        <Button android:id="@+id/btnCondividi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Condividi ultimo PDF"/>
    </LinearLayout>
</ScrollView>
